# -----------------------------------------------------------------------------
# Landing de eventos Transworld
# -----------------------------------------------------------------------------
PORT=3020
NODE_ENV=development

# URL pública (canonical y og:url). Sin barra final.
PUBLIC_URL=

# -----------------------------------------------------------------------------
# Fuente de datos de eventos: mock | api | supabase
#   supabase = base NEXUS (eventos, talleres, cupos e inscripciones reales)
# -----------------------------------------------------------------------------
EVENTS_SOURCE=mock
# Requeridas con EVENTS_SOURCE=supabase. Proyecto NEXUS (el mismo de la app RegisPro).
# Clave PUBLICABLE del formulario web (sb_publishable_…), nunca la secreta. Solo la usa el servidor.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Segundos que se reutiliza la lectura de la base (cupos y talleres) antes de volver a consultarla
EVENTS_CACHE_TTL_S=30
# Requerida con EVENTS_SOURCE=api (GET /events, /events/:id, /categories)
EVENTS_API_URL=
# Latencia simulada del mock en ms (para revisar estados de carga)
EVENTS_MOCK_LATENCY_MS=0

# -----------------------------------------------------------------------------
# Inscripciones: intentos permitidos por IP en la ventana (segundos)
# -----------------------------------------------------------------------------
REGISTRATION_RATE_LIMIT=10
REGISTRATION_RATE_WINDOW_S=600

# -----------------------------------------------------------------------------
# Guía viva del Design System (/sistema-de-diseno). Siempre activa fuera de producción.
# -----------------------------------------------------------------------------
DS_SHOWCASE=0
